# Telegram bot token from @BotFather (/newbot)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Telegram numeric user id (send /start to @userinfobot on Telegram, it replies with your id)
OWNER_CHAT_ID=123456789

# Random secret for the Telegram webhook (use the same value in the setWebhook URL)
WEBHOOK_SECRET=change-me-to-a-random-string

# Port (Render sets PORT automatically; locally 3000 is fine)
PORT=3000

# Public URL of this server, e.g. https://your-app.onrender.com (only used in the startup log)
PUBLIC_URL=https://your-app.onrender.com

# --- GramJS userbot bridge (OPTIONAL — for operating income bots) ---
# api_id / api_hash: create an app at https://my.telegram.org/apps
TG_API_ID=123456
TG_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TG_SESSION: the GramJS session string from running `node login.js` once
# locally. It logs in as YOUR Telegram account (the userbot). Never share it.
TG_SESSION=

# ADMIN_BOTS_SECRET: random secret for the WordPress admin panel's bot sync
# (POST /api/admin/bots/sync). Put the SAME value in the MLA Bots admin
# snippet (mla-bots-admin.php). Never put it on a user-facing page.
ADMIN_BOTS_SECRET=change-me-to-a-random-string
