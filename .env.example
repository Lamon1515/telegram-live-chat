# Telegram bot token from @BotFather (/newbot)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Telegram numeric user id (send /start to @userinfobot on Telegram, it replies with your id)
OWNER_CHAT_ID=123456789

# Random secret for the Telegram webhook (use the same value in the setWebhook URL)
WEBHOOK_SECRET=change-me-to-a-random-string

# Port (Render sets PORT automatically; locally 3000 is fine)
PORT=3000

# Public URL of this server, e.g. https://your-app.onrender.com (only used in the startup log)
PUBLIC_URL=https://your-app.onrender.com
